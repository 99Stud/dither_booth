{
  "name": "@dither-booth/ui",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.tsx",
    "#hooks/*": "./src/hooks/*.tsx"
  },
  "exports": {
    "./components/misc/Webcam": "./src/components/misc/Webcam/index.tsx",
    "./components/misc/ThemeToggle": "./src/components/misc/ThemeToggle/index.tsx",
    "./components/misc/IconBubble": "./src/components/misc/IconBubble/index.tsx",
    "./components/misc/WifiCard": "./src/components/misc/WifiCard/index.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/svg/*": "./src/components/svg/*.tsx",
    "./fields/*": "./src/fields/*/index.tsx",
    "./hooks/user-media": "./src/hooks/user-media/index.tsx",
    "./brand": "./src/lib/brand.tsx",
    "./haptics": "./src/lib/haptics.tsx",
    "./virtual-keyboard": "./src/lib/virtual-keyboard.tsx",
    "./lib/image-manipulation": "./src/lib/image-manipulation/index.tsx",
    "./lib/hooks/user-media": "./src/lib/hooks/user-media/index.tsx",
    "./shadcn.css": "./src/styles/shadcn.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "update": "bun update -i",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --isolate",
    "brand": "bun scripts/brand-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dither-booth/logging": "workspace:*",
    "@dither-booth/shared": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-form": "1.33.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.27.0",
    "next-themes": "0.4.6",
    "react-day-picker": "10.0.2",
    "recharts": "3.8.0",
    "shadcn": "4.16.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "web-haptics": "0.0.6"
  },
  "devDependencies": {
    "@dither-booth/typescript-config": "workspace:*",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.3"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
