{
  "name": "@dither-booth/shared",
  "private": true,
  "type": "module",
  "imports": {
    "#browser/*": "./src/browser/*.ts",
    "#internal/*": "./src/internal/*.ts",
    "#isomorphic/*": "./src/isomorphic/*.ts",
    "#server/*": "./src/server/*.ts"
  },
  "exports": {
    "./async": "./src/isomorphic/async.ts",
    "./browser/blob": "./src/browser/blob.ts",
    "./browser/camera-preview": "./src/browser/camera-preview.ts",
    "./browser/image": "./src/browser/image.ts",
    "./browser/receipt-viewer": "./src/browser/receipt-viewer.ts",
    "./browser/storage": "./src/browser/storage.ts",
    "./browser/trpc-client": "./src/browser/trpc-client.ts",
    "./camera-preview": "./src/isomorphic/camera-preview.ts",
    "./darkroom": "./src/isomorphic/darkroom.ts",
    "./errors": "./src/isomorphic/errors.ts",
    "./formatting": "./src/isomorphic/formatting.ts",
    "./healthz": "./src/isomorphic/healthz.ts",
    "./id": "./src/isomorphic/id.ts",
    "./kiosk": "./src/isomorphic/kiosk.ts",
    "./background-controls": "./src/isomorphic/background-controls.ts",
    "./backgrounds": "./src/isomorphic/backgrounds.ts",
    "./booth-system": "./src/isomorphic/booth-system.ts",
    "./booth-update": "./src/isomorphic/booth-update.ts",
    "./kit-copy": "./src/isomorphic/kit-copy.ts",
    "./kit-fonts": "./src/isomorphic/kit-fonts.ts",
    "./kit-partners": "./src/isomorphic/kit-partners.ts",
    "./kit-preview": "./src/isomorphic/kit-preview.ts",
    "./kits": "./src/isomorphic/kits.ts",
    "./lottery": "./src/isomorphic/lottery.ts",
    "./printer": "./src/isomorphic/printer.ts",
    "./printing": "./src/isomorphic/printing.ts",
    "./routes": "./src/isomorphic/routes.ts",
    "./runtime": "./src/isomorphic/runtime.ts",
    "./server/booth-update": "./src/server/booth-update.ts",
    "./server/database-backup": "./src/server/database-backup.ts",
    "./server/network": "./src/server/network.ts",
    "./server/paths": "./src/server/paths.ts",
    "./server/process-identity": "./src/server/process-identity.ts",
    "./server/release": "./src/server/release.ts",
    "./server/runtime": "./src/server/runtime.ts",
    "./server/systemctl": "./src/server/systemctl.ts",
    "./styles": "./src/isomorphic/styles.ts",
    "./ticket": "./src/isomorphic/ticket.ts",
    "./trpc-proxy": "./src/isomorphic/trpc-proxy.ts"
  },
  "scripts": {
    "update": "bun update -i",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.isomorphic.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@dither-booth/ports": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dither-booth/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17"
  }
}
