{
  "name": "@dither-booth/protocol",
  "private": true,
  "type": "module",
  "imports": {
    "#isomorphic/*": "./src/isomorphic/*.ts"
  },
  "exports": {
    "./heartbeat": "./src/isomorphic/heartbeat.ts",
    "./heartbeat.fixtures": "./src/isomorphic/heartbeat.fixtures.ts"
  },
  "scripts": {
    "update": "bun update -i",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.isomorphic.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dither-booth/shared": "workspace:*",
    "@dither-booth/typescript-config": "workspace:*",
    "@types/bun": "1.3.14"
  }
}
