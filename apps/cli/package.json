{
  "name": "@dither-booth/cli",
  "private": true,
  "bin": {
    "booth": "./src/index.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "update": "bun update -i",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.21",
    "@clack/prompts": "^1.7.0",
    "@dither-booth/ports": "workspace:*",
    "@dither-booth/shared": "workspace:*",
    "citty": "^0.2.2",
    "figlet": "^1.11.0"
  },
  "devDependencies": {
    "@dither-booth/typescript-config": "workspace:*",
    "@types/bun": "1.3.14"
  }
}
