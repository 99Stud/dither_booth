{
  "name": "@dither-booth/studio",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#sw/*": "./src/sw/*.ts"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "tsc --noEmit -p tsconfig.json && bun scripts/build.ts",
    "update": "bun update -i",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@dither-booth/protocol": "workspace:*",
    "@dither-booth/ui": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.27.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dither-booth/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.1.2",
    "sharp": "0.35.3"
  }
}
